#pragma once

// The HD texture recipe this build offers, set when the port is configured
// (SARUSARU_TEXTURE_RECIPE_*). Empty: the build offers none.
#include <string_view>

namespace sarusaru::install {
inline constexpr std::string_view kTextureRecipeUrl = "@SARUSARU_TEXTURE_RECIPE_URL@";
inline constexpr std::string_view kTextureRecipeSha256 = "@SARUSARU_TEXTURE_RECIPE_SHA256@";
inline constexpr std::string_view kTextureRecipeSize = "@SARUSARU_TEXTURE_RECIPE_SIZE@";
// The prebuilt HD texture pack (SARUSARU_HD_PACK_*): a zip of a pack
// directory (textures/hd_pack.hpp). Empty: HD is made on the device.
inline constexpr std::string_view kPrebuiltPackUrl = "@SARUSARU_HD_PACK_URL@";
inline constexpr std::string_view kPrebuiltPackSha256 = "@SARUSARU_HD_PACK_SHA256@";
inline constexpr std::string_view kPrebuiltPackSize = "@SARUSARU_HD_PACK_SIZE@";
// The same pack resized to 3x and 2x (SARUSARU_HD3_PACK_*, SARUSARU_HD2_PACK_*).
inline constexpr std::string_view kPrebuiltPack3Url = "@SARUSARU_HD3_PACK_URL@";
inline constexpr std::string_view kPrebuiltPack3Sha256 = "@SARUSARU_HD3_PACK_SHA256@";
inline constexpr std::string_view kPrebuiltPack3Size = "@SARUSARU_HD3_PACK_SIZE@";
inline constexpr std::string_view kPrebuiltPack2Url = "@SARUSARU_HD2_PACK_URL@";
inline constexpr std::string_view kPrebuiltPack2Sha256 = "@SARUSARU_HD2_PACK_SHA256@";
inline constexpr std::string_view kPrebuiltPack2Size = "@SARUSARU_HD2_PACK_SIZE@";
} // namespace sarusaru::install
