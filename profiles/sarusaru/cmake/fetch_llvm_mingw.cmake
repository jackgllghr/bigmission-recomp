# Downloads, checks and unpacks the pinned llvm-mingw (LlvmMingw.cmake), for
# building the Windows port:
#   cmake -DHOST=windows|linux-x64|linux-arm64 -DDEST=<directory> -P fetch_llvm_mingw.cmake
# The toolchain ends up in <directory>/llvm-mingw (llvm-mingw.toolchain.cmake).
cmake_minimum_required(VERSION 3.20)
include("${CMAKE_CURRENT_LIST_DIR}/LlvmMingw.cmake")
if(HOST STREQUAL "windows")
    set(url "${SARUSARU_LLVM_MINGW_URL}")
    set(sha256 "${SARUSARU_LLVM_MINGW_SHA256}")
elseif(HOST STREQUAL "linux-x64")
    set(url "${SARUSARU_LLVM_MINGW_LINUX_X64_URL}")
    set(sha256 "${SARUSARU_LLVM_MINGW_LINUX_X64_SHA256}")
elseif(HOST STREQUAL "linux-arm64")
    set(url "${SARUSARU_LLVM_MINGW_LINUX_ARM64_URL}")
    set(sha256 "${SARUSARU_LLVM_MINGW_LINUX_ARM64_SHA256}")
else()
    message(FATAL_ERROR "HOST must be windows, linux-x64 or linux-arm64")
endif()
if(NOT DEST)
    message(FATAL_ERROR "Set DEST to the directory for the toolchain")
endif()
if(EXISTS "${DEST}/llvm-mingw/sarusaru.stamp")
    file(READ "${DEST}/llvm-mingw/sarusaru.stamp" stamp)
    if(stamp STREQUAL sha256)
        message(STATUS "llvm-mingw ${SARUSARU_LLVM_MINGW_VERSION} already in ${DEST}/llvm-mingw")
        return()
    endif()
endif()
string(REGEX MATCH "[^/]+$" archive_name "${url}")
set(archive "${DEST}/${archive_name}")
message(STATUS "Downloading ${url}")
file(DOWNLOAD "${url}" "${archive}" EXPECTED_HASH SHA256=${sha256} TLS_VERIFY ON STATUS status)
list(GET status 0 code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Cannot download ${url}: ${status}")
endif()
file(REMOVE_RECURSE "${DEST}/llvm-mingw" "${DEST}/_unpack")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${DEST}/_unpack")
file(GLOB unpacked LIST_DIRECTORIES true "${DEST}/_unpack/*")
file(RENAME "${unpacked}" "${DEST}/llvm-mingw")
file(REMOVE_RECURSE "${DEST}/_unpack" "${archive}")
file(WRITE "${DEST}/llvm-mingw/sarusaru.stamp" "${sha256}")
message(STATUS "llvm-mingw ${SARUSARU_LLVM_MINGW_VERSION} in ${DEST}/llvm-mingw")
